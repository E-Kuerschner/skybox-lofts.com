{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skybox-lofts",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
  },
  "routes": [
    {
      "pattern": "skybox-lofts.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./client/assets"
  },
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "documents"
    }
  ]
}
