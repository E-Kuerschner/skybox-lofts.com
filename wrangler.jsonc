{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skybox-lofts",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
  },
  "routes": [
    {
      "pattern": "skybox-lofts.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./client/assets"
  },
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "documents"
    },
    {
      "binding": "CONTRACTOR_PHOTOS",
      "bucket_name": "contractor-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "APP",
      "database_name": "app",
      "database_id": "b24a968f-19e4-47d9-a981-89ab2204f486",
      "migrations_dir": "./database/migrations"
    }
  ]
}
