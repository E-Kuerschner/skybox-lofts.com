{
  "name": "skybox-lofts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "react-router dev",
    "postinstall": "bun cf-typegen",
    "preview": "bun build && vite preview",
    "typecheck": "bun cf-typegen && react-router typegen && tsc -b",
    "auth:generate": "bunx --bun @better-auth/cli generate --config ./better-auth-config.ts --yes --output database/authSchema.ts",
    "db:generate": "bun auth:generate && drizzle-kit generate --config database/drizzle.config.ts",
    "db:migrate": "bun --env-file=.dev.vars drizzle-kit --config database/drizzle.config.ts migrate",
    "db:migrate:local": "wrangler d1 migrations apply app --local",
    "db:seed": "bun --env-file=.dev.vars ./scripts/seedDefaultUser.ts --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && bun run db:migrate:local && bun ./scripts/seedDefaultUser.ts --local",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "^1.3.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "isbot": "^5.1.31",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.2",
    "resend": "^6.1.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.5",
    "@react-router/dev": "^7.9.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.2.23",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.5",
    "msw": "^2.12.14",
    "prettier": "^3.6.2",
    "shadcn": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.40.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
