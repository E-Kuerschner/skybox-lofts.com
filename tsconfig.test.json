{
  "extends": "./tsconfig.cloudflare.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts",
    "database/schema.ts",
    "database/authSchema.ts",
    "database/auth.config.ts",
    "tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["vite/client", "bun-types"]
  }
}
